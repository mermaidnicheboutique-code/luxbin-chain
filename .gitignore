# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.backup

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust/Cargo
**/target/
**/*.rs.bk
Cargo.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
*.egg
.pytest_cache/
venv/
env/

# Large files and archives
*.zip
*.tar.gz
*.dmg
*.pkg

# Backup files
*.backup
*~

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.Trash/
Thumbs.db

# Temporary repos
temp_repo_*/

# Large external projects (keep separate repos)
cdp-sdk/
my-base-project/
superchainerc20-starter/
miniforge/
quantum_consciousness_db/

# Binaries
polkadot
substrate
substrate-node
substrate-node-aarch64
get-pip.py
